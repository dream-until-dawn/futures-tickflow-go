// FutureSearch begin
//------------------------------------------------------------------------------
var FutureSearch = {
	url: "http://finance.sina.com.cn/money/future/quote.html?",
	Init: function () {
	},
	fillByArr: function (obj, items) {
		obj.innerHTML = "";
		for (var i = 0; i < items.length; i++) {
			obj.options[i] = new Option(items[i][0]);
		};
	},
	fillBylist: function (obj, items) {
		obj.innerHTML = "";
		for (var i = 0; i < items.length; i++) {
			obj.options[i] = new Option(items[i]);
		};
	},
	changeJYS: function () {
		var nIndex = this.JYSsel.selectedIndex;
		this.fillBylist(this.PZSsel, PZ[nIndex]);
		this.changePZ();
	},
	changePZ: function () {
		var nIndex1 = this.JYSsel.selectedIndex, nIndex2 = this.PZSsel.selectedIndex;
		this.fillByArr(this.HYSsel, YF[nIndex1][nIndex2]);
	},
	toResult: function () {
		var nIndex1 = this.JYSsel.selectedIndex, nIndex2 = this.PZSsel.selectedIndex, nIndex3 = this.HYSsel.selectedIndex;
		if (nIndex1 == 0) {
			alert("请选择期货!");
			return ;
		}
		if (nIndex1 == 4) {
			window.open(__IF_URL.replace("__CODE__", YF[nIndex1][nIndex2][nIndex3][1]));
		}
		else {
			window.open(this.url + YF[nIndex1][nIndex2][nIndex3][1]);
		}
	}
}


//------------------------------------------------------------------------------
// HoldBuild begin
//------------------------------------------------------------------------------
var HoldBuild = {
	holdUrl: 'http://biz.finance.sina.com.cn/futures/hold/detail.php?t_breed=@CODE@&t_date=@DATE@',
	buildUrl: 'http://biz.finance.sina.com.cn/futures/hold/history.php?t_breed=@CODE@&shortname=@AGENCY@',
	Init: function () {
		this.holdSel1 = $("hold_sel1");
		this.holdSel2 = $("hold_sel2");
		this.holdSel1.onchange = this.changeJYS.Bind(this, this.holdSel1, this.holdSel2);
		$("btn_hold").onclick = this.goToHold.Bind(this);
		var tempDate = new Date();
		$("hold_calendar").value = tempDate.getFullYear() + "-" + (tempDate.getMonth() + 1) + "-" + tempDate.getDate();

		FutureSearch.fillBylist(this.holdSel1, JYS);
		this.fillAll(this.holdSel2);

		this.clone(this.holdSel1, $("build_sel1_wrap"), "build_sel1");
		this.clone(this.holdSel2, $("build_sel2_wrap"), "build_sel2");
		this.buildSel1 = $("build_sel1");
		this.buildSel2 = $("build_sel2");
		this.buildSel3 = $("build_sel3");
		$("btn_build").onclick = this.goToBuild.Bind(this);
		
		this.buildSel1.onchange = this.changeJYS.Bind(this, this.buildSel1, this.buildSel2);
		this.fillAgency();
	},
	clone: function (objFrom, wrapper, sId) {
		var tempNode = objFrom.cloneNode(true);
		tempNode.id = sId;
		wrapper.appendChild(tempNode);
	},
	fillAll: function (obj) {
		obj.innerHTML = "";
		var nIndex = 0;
		for (var i = 0; i < YF.length; i++) {
			for (var j = 0; j < YF[i].length; j++) {
				for (var k = 0; k < YF[i][j].length; k++) {
					obj.options[nIndex] = new Option(YF[i][j][k][0]);
					obj.options[nIndex].value = YF[i][j][k][1];
					nIndex++;
				};
			};
		};
	},
	fillOne: function (obj, nIndex) {
		obj.innerHTML = "";
		var opIndex = 0;
		for (var i = 0; i < YF[nIndex].length; i++) {
			for (var j = 0; j < YF[nIndex][i].length; j++) {
				obj.options[opIndex] = new Option(YF[nIndex][i][j][0]);
				obj.options[opIndex].value = YF[nIndex][i][j][1];
				opIndex++;
			};
		};
	},
	fillAgency: function () {
		this.buildSel3.innerHTML = "";
		this.buildSel3.options[0] = new Option("机构");
		for (var i = 0; i < jigou_all.length; i++) {
			this.buildSel3.options[i + 1] = new Option(jigou_all[i]);
			this.buildSel3.options[i + 1].value = jigou_all[i];
		};
	},
	changeJYS: function (sel, obj) {
		var nIndex = sel.selectedIndex;
		if (nIndex != 0) {
			this.fillOne(obj, nIndex);
		}
		else if (nIndex == 0) {
			this.fillAll(obj);
		}
	},
	goToHold: function () {
		if (this.holdSel1.selectedIndex == 0 && this.holdSel2.selectedIndex == 0) {
			alert("请选择期货");
			return ;
		}
//		if (/^\d{4}\-\d{1,2}\-\d{1,2}$/.test($("hold_calendar").value) != true) {
		if (/^(19|20)\d{2}-((0?[1-9])|(1[12]))-((0?[1-9])|(1[0-9])|(2[0-9])|(3[01]))$/.test($("hold_calendar").value) != true) {
			alert("请按格式输入日期，例:2008-01-05");
			var tempDate = new Date();
			$("hold_calendar").value = tempDate.getFullYear() + "-" + (tempDate.getMonth() + 1) + "-" + tempDate.getDate();
			return ;
		}
		window.open(this.holdUrl.replace("@CODE@", this.holdSel2.value).replace("@DATE@", $("hold_calendar").value));
	},
	goToBuild: function () {
		if (this.buildSel1.selectedIndex == 0 && this.buildSel2.selectedIndex == 0) {
			alert("请选择期货");
			return ;
		}
		if (this.buildSel3.selectedIndex == 0) {
			alert("请选择机构");
			return ;
		}
		window.open(this.buildUrl.replace("@CODE@", this.buildSel2.value).replace("@AGENCY@", this.buildSel3.value));
	}
}


