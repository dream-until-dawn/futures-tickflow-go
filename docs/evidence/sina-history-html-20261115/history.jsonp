<SCRIPT LANGUAGE="JavaScript" type="text/javascript">
<!--
//------------------------------------------------------------------------------
// FutureSearch begin
//------------------------------------------------------------------------------
var FutureSearch2 = {
	url: "",
	d_JYS:0,
	d_PZ:0,
	d_HY:0,
	Init: function (jys, pz, hy) {
		this.d_JYS = jys;
		this.d_PZ = pz;
		this.d_HY = hy;
		this.JYSsel = $("selJYS");
		this.PZSsel = $("selPZ");
		this.HYSsel = $("selHY");
		this.SDate = $("id_start_date");
		this.EDate = $("id_end_date");
		this.ButtonS = $("btnSearch");
		this.Futures = $("futuresname");

		var calendar1 = new Calendar("id_start_date", false, false, [140, 800, 0.95, "solid", "#EEE", "#FFF", 3, 3, 0.2, "#000", "#444", "#F6F8FD", "#333", "#F1F5FC", "#000", "#EFF3FB", false, false]);
		var calendar2 = new Calendar("id_end_date", false, false, [140, 800, 0.95, "solid", "#EEE", "#FFF", 3, 3, 0.2, "#000", "#444", "#F6F8FD", "#333", "#F1F5FC", "#000", "#EFF3FB", false, false]);

		this.JYSsel.onchange = this.changeJYS.Bind(this);
		this.PZSsel.onchange = this.changePZ.Bind(this);
		this.ButtonS.onclick = this.toResult.Bind(this);

		this.fillBylist(this.JYSsel, JYS);
		this.fillBylist(this.PZSsel, PZ[0]);
		this.fillByArr(this.HYSsel, YF[0][0]);

		//设置默认
		if (this.d_JYS != 0)
		{
			this.setDefault (this.JYSsel, JYS, this.d_JYS);
			this.changeJYS();
			//写选中的期货名字
			this.Futures.innerHTML = YF[this.d_JYS][this.d_PZ][this.d_HY][0];
		}
	},
	fillByArr: function (obj, items, m) {
		obj.innerHTML = "";
		for (var i = 0; i < items.length; i++) {
			obj.options[i] = new Option(items[i][0]);
			if (m != 'undefined' && i == m)
			{
				obj.options[i].selected = true;
			}
		};
	},
	fillBylist: function (obj, items, m) {
		obj.innerHTML = "";
		for (var i = 0; i < items.length; i++) {
			obj.options[i] = new Option(items[i]);
			if (m != 'undefined' && i == m)
			{
				obj.options[i].selected = true;
			}
		};
	},
	changeJYS: function () {
		var nIndex = this.JYSsel.selectedIndex;
		this.fillBylist(this.PZSsel, PZ[nIndex], this.d_PZ);
		this.changePZ();
	},
	changePZ: function () {
		var nIndex1 = this.JYSsel.selectedIndex, nIndex2 = this.PZSsel.selectedIndex;
		this.fillByArr(this.HYSsel, YF[nIndex1][nIndex2], this.d_HY);
	},
	setDefault: function (obj,items, m)
	{
		for (var i = 0; i < items.length; i++) 
		{
			if (i == m)
			{
				obj.options[i].selected = true;
			}
		};
	},
	
	toResult: function () {
		var pattern = /^(\d{4})(-)(\d{2})(-)(\d{2})$/; 
		var nIndex1 = this.JYSsel.selectedIndex, nIndex2 = this.PZSsel.selectedIndex, nIndex3 = this.HYSsel.selectedIndex;
		var startDate = this.SDate.value;
		var endDate = this.EDate.value;
		if (nIndex1 == 0) {
			alert("请选择期货!");
			return ;
		}
		if (startDate != '' && startDate.match(pattern) == null)
		{
			alert("请输入正确的开始日期格式 YYYY-MM-DD");
			return;
		}
		if (endDate != '' && endDate.match(pattern) == null)
		{
			alert("请输入正确的结束日期格式 YYYY-MM-DD");
			return;
		}
		if (startDate != '' && endDate !='' && !compareDate(endDate, startDate))
		{
			alert("结束日期应该大于开始日期");
			return;
		}
		window.location = "?jys="+nIndex1+"&pz="+nIndex2+"&hy="+nIndex3+"&breed="+YF[nIndex1][nIndex2][nIndex3][1]+"&start="+this.SDate.value+"&end="+this.EDate.value;
	}
}
//比较日期大小
function compareDate(DateOne,DateTwo)
{
	var OneMonth = DateOne.substring(5,DateOne.lastIndexOf ("-"));
	var OneDay = DateOne.substring(DateOne.length,DateOne.lastIndexOf ("-")+1);
	var OneYear = DateOne.substring(0,DateOne.indexOf ("-"));

	var TwoMonth = DateTwo.substring(5,DateTwo.lastIndexOf ("-"));
	var TwoDay = DateTwo.substring(DateTwo.length,DateTwo.lastIndexOf ("-")+1);
	var TwoYear = DateTwo.substring(0,DateTwo.indexOf ("-"));

	if (Date.parse(OneMonth+"/"+OneDay+"/"+OneYear) > Date.parse(TwoMonth+"/"+TwoDay+"/"+TwoYear))
	{
		return true;
	}
	else
	{
		return false;
	} 
}

function goto_page(page_num,page_count, comm_str)
{
	if(isDigit(page_num) == true)
	{
		if(page_num >= 1 && page_num <= page_count)
		{
			window.location = "/q//view/vFutures_History.php?page=" + page_num + "&" + comm_str;
			return false;
		}
		else if(page_num < 1)
		{//输入小于首页页号则跳到首页
			window.location = "/q//view/vFutures_History.php?page=1&"+comm_str;
			return false;
		}
		else if(page_num > page_count)
		{//大于尾页则跳转到尾页
			window.location = "/q//view/vFutures_History.php?page=" + page_count + "&" + comm_str;
			return false;
		}
		else
		{//输入小于首页页号则跳到首页
			window.location = "/q//view/vFutures_History.php?page=1&"+comm_str;
			return false;
		}
	}
	else
	{
		window.location = "/q//view/vFutures_History.php?page=1&"+comm_str;
		return false;
	}
}
function isDigit(s)  
{  
	var patrn=/^[0-9]{1,3}$/;  
	if (!patrn.exec(s)) return false;
	return true ;
}  

//-->
</SCRIPT>
