S_SL_CF_FU_DIG2 = function(o)
{
var a = ['trade', 'close', 'open', 'high', 'low', 'bid', 'ask', 'settlement', 'prevsettlement'];
for (var x in o.aFields)
{
    for (var y in a)
    {
        if (o.aFields[x].f == a[y])
        {
            o.aFields[x].d = 2;
        }
    }
}
};


(new function(){
this.HASHTAG = 'contPos_';
this.HASHTAGT = 'titlePos_';
this.boot = function()
{
    var a;
    var o, i, j;
    this._oTop = document.getElementById('hq_table_nav');
    this._oTbl = document.getElementById('hq_table_id');
    if (!this._oTop || !this._oTbl)
    {
        return;
    }
    this.initTabs();
    this._aNodes = [];
    var num = 1;
    for (var x in ARRFUTURESNODES)
    {
        this.appendTitle(ARRFUTURESNODES[x][0]);
        a = [];
        for (i = 1; i < ARRFUTURESNODES[x].length; i++)
        {
            o = {'name': ARRFUTURESNODES[x][i][0], 'node': ARRFUTURESNODES[x][i][1], 'jys': ARRFUTURESNODES[x][0]};
            //o.link = ARRFUTURESNODES[x][i][1];
            o.num = ARRFUTURESNODES[x][i][4] ? ARRFUTURESNODES[x][i][4] : 5;
            //if (o.link.length < 4)
            //{
            o.link = 'http://money.finance.sina.com.cn/mkt/#' + ARRFUTURESNODES[x][i][1];;
            //}
            o.base = (ARRFUTURESNODES[x][i][3]) ? ARRFUTURESNODES[x][i][3] : 'futures';
            o.tab = this._aNodes.length;
            switch (o.base)
            {
                case 'futures':
                case 'futuresindex':
                case 'futures.fu_dig2':
                    o.sort = 'position';
                    break;
                case 'futuresglobal':
                    o.sort = 'name';
                    break;
                case 'futuresgoods':
                    o.sort = 'symbol';
                    break;
                default:
                    o.sort = 'symbol';
            }
            a.push(o);
            this.createTopNavDiv(num);
            this.appendTopNav(o);
            num++;
            //this.appendContDiv(o);
        }
        this._aNodes.push(a);
    }
    this.switchTab(this.searchNav(location.hash));
};
this.initTabs = function()
{
    var o;
    this._oTabs = document.createElement('div');
    this._oTabs.className = 'divTab';
    this._oUlTabs = document.createElement('ul');
    this._oTabs.appendChild(this._oUlTabs);
    this._oCont = document.createElement('div');
    this._oCont.className = 'divCont';
    this._oTbl.appendChild(this._oTabs);
    this._oTbl.appendChild(this._oCont);
    this._aTabs = [];
    this._aConts = [];
    this._aLDRs = [];
    this._iCurrTab = -1;
    
    this._oTopItem = document.createElement('div'); 
    this._oTopItem.className = 'top';
    this._oTopItem.setAttribute('id', 'top');
    this._oTop.appendChild(this._oTopItem);
};
this.switchTabEvt = function(ev)
{
    var t, i;
    t = ev.target ? ev.target : ev.srcElement;
    if (t)
    {
        i = t.getAttribute('id');
        i = i.split('_');
        i = parseInt(i.pop());
        this.switchTab(i);
    }
    return true;
    //return false;
};
this.switchTabNav = function(ev)
{
    var a, i;
    t = ev.target ? ev.target : ev.srcElement;
    if (t)
    {
        a = t.getAttribute('href');
        i = this.searchNav(a);
        this.switchTab(i);
    }
    return true;
};
this.searchNav = function(h)
{
    var a;
    a = h;
    if (a.charAt(0) == '#')
    {
        a = a.substr(1);
    }
    if (a.substr(0, this.HASHTAG.length) == this.HASHTAG)
    {
        a = a.substr(this.HASHTAG.length);
        for (var x in this._aNodes)
        {
            for (i = 0; i < this._aNodes[x].length; i++)
            {
                if (this._aNodes[x][i].node == a)
                {
                    return x;
                }
            }
        }
    }
    else if (a.substr(0, this.HASHTAGT.length) == this.HASHTAGT)
    {
        a = a.substr(this.HASHTAGT.length);
        a = parseInt(a);
        if (a < 0 || a >= this._aTabs.length)
        {
            a = 0;
        }
        else
        {
            return a;
        }
    }
    //this.switchTab(id);
    return 0;
};
this.switchTab = function(id)
{
    var o, a;
    if (this._iCurrTab == id)
    {
        return false;
    }
    if (this._iCurrTab >= 0)
    {
        this._aTabs[this._iCurrTab].className = '';
        if (this._aLDRs[this._iCurrTab])
        {
            for(var x in this._aLDRs[this._iCurrTab])
            {
                this._aLDRs[this._iCurrTab][x].EnableTimer(false);
            }
        }
        if (this._aConts[this._iCurrTab])
        {
            this._aConts[this._iCurrTab].style.display = 'none';
        }
    }
    if (!this._aConts[id])
    {
        o = document.createElement('div');
        o.style.width = '100%';
        this._oCont.appendChild(o);
        a = [];
        for(var x in this._aNodes[id])
        {
            a.push(this.appendContDiv(this._aNodes[id][x], o));
        }
        this._aConts[id] = o;
        this._aLDRs[id] = a;
    }
    else
    {
        this._aConts[id].style.display = '';
        for(var x in this._aLDRs[id])
        {
            this._aLDRs[id][x].EnableTimer(true);
        }
    }
    this._aTabs[id].className = 'hotItem';
    this._iCurrTab = id;
};
this.appendTitle = function(t)
{
    var o, a, s;
    o = document.createElement('li');
    a = document.createElement('a');
    a.setAttribute('href', '#' + this.HASHTAGT + this._aTabs.length);
    Util.AddEvent(a, 'click', this.switchTabEvt._BindForEvent(this));
    a.appendChild(document.createTextNode(t));
    a.setAttribute('id', 'tab_switch_' + this._aTabs.length);
    o.appendChild(a);
    this._oUlTabs.appendChild(o);
    this._aTabs.push(o);
    //var o;
    //o = document.createElement('div');
    //o.className = 'extitle';
    //o.appendChild(document.createTextNode(t));
    //this._oTbl.appendChild(o);
};
this.createTopNavDiv = function(num)
{
    var o;
    if(num % 26 == 0)
    {
        o = document.createElement('div');
        o.setAttribute('class', 'top');
        o.setAttribute('id', 'top'+num);
        this._oTop.appendChild(o);		
        this._oTopItem = document.getElementById('top'+num);	
        this._bAtnf = 0;
    }
};
this.appendTopNav = function(t)
{
    var o;
    if (!this._bAtnf)
    {
        this._bAtnf = 1;
    }
    else
    {
        this._oTopItem.appendChild(document.createTextNode('┊'));
    }
    o = document.createElement('a');
    o.setAttribute('href', '#' + this.HASHTAG + t.node);
    Util.AddEvent(o, 'click', this.switchTabNav._BindForEvent(this));
    o.appendChild(document.createTextNode(t.name));
    this._oTopItem.appendChild(o);
};
this._getDivHeight = function(h)
{
    return (h * 22 + 100) + 'px';
};
this.appendContDiv = function(t, c)
{
    var o, o1, o2;
    o = document.createElement('div');
    o1 = document.createElement('div');
    o1.className = 'itemtitle';
    //o2 = document.createElement('a');
    //o2.setAttribute('name', this.HASHTAG + t.node);
    //o2.name = this.HASHTAG + t.node;
    //o2.appendChild(document.createTextNode(t.name));
    //o1.appendChild(o2);
    o1.innerHTML = '<a name="' + this.HASHTAG + t.node + '" href="' + t.link + '" target="_blank">' + t.name + '</a>';
    o.appendChild(o1);
    o1 = document.createElement('a');
    o1.setAttribute('href', '#');
    o2 = document.createElement('img');
    o2.setAttribute('src', '//www.sinaimg.cn/cj/2011/0527/top.gif ');
    o1.appendChild(o2);
    o1.style.cssFloat = o1.style.styleFloat = 'right';
    o1.style.display = 'block';
    o.appendChild(o1);
    o1 = document.createElement('div');
    o1.className = 'tableCont';
    o1.setAttribute('id', 'div_cont_' + t.node);
    o.appendChild(o1);
    o.className = 'div_cont_wt';
    o.style.height = this._getDivHeight(t.num);
    c.appendChild(o);
    o1 = new S_SLLDR();
    //alert(window['S_SL_' + t.base.toUpperCase()]);
    //alert
    (o1.Load(t.base, 'div_cont_' + t.node, {node: t.node, num: t.num, sort: t.sort, asc: 0}, function(){}, undefined, {bNoWaitMask: 1/*, iSRVType: 1*/}));
    return o1;
};
}).boot();

